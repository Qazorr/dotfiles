# Multi-GB binaries, and local machine access rather than repo content.
iso/cache/
iso/out/
vm/disk/
vm/host-access/

# Per-machine installer answers: a password hash, a disk to erase.
iso/config.local

# Written on first run by the app itself.
home/cava/.config/cava/shaders/

# matugen regenerates these on every theme change, and the config dirs are
# stow symlinks into this repo, so the writes land here. Scoped to the
# generated files only: binds-user.lua and windowrules.lua next to colors.lua
# ARE ours.
home/hypr/.config/hypr/dms/colors.lua
home/hypr/.config/hypr/dms/input.lua
home/hypr/.config/hypr/dms/layout.lua
home/kitty/.config/kitty/dank-*.conf

# Claude Code's self-updater rewrites this symlink to point at the version it
# just installed, and ~/.local/bin is a stow symlink into this repo.
home/scripts/.local/bin/claude

# Machine-local Hyprland config: the NVIDIA env block and anything else
# specific to one box. Created by step_stow, written by step_nvidia.
home/hypr/.config/hypr/conf/local.lua

# ~/.local/share/wallpapers is a whole-directory stow symlink, so dharmx/walls
# (the walls step, opt-in, ~3.7GB) lands physically in the repo. Refetched by
# the step's `git pull`.
home/wallpaper/.local/share/wallpapers/walls/

# Symlink farm over walls/ built by the walls step.
home/wallpaper/.local/share/wallpapers/all/

# What the installer already knows. Anything left empty is asked on screen.
# Machine-specific values go in iso/config.local (untracked), same format.

INSTALL_HOSTNAME=""
INSTALL_USER=""
INSTALL_FULLNAME=""
# From `openssl passwd -6`.
INSTALL_PASSWORD_HASH=""

INSTALL_LOCALE="en_US.UTF-8"
# The console and the installer. The desktop takes kb_layout from
# home/hypr/.config/hypr/conf/input.lua.
INSTALL_KEYMAP="pl"
INSTALL_TIMEZONE="Europe/Warsaw"

# A whole disk, e.g. /dev/nvme0n1. It is ERASED without a question.
# Empty: partition in the installer.
INSTALL_DISK=""

# What the first boot runs: ./bootstrap.sh --profile <profile> <steps>
INSTALL_PROFILE="full"
# Opt-in steps on top of the profile, e.g. "nvidia".
INSTALL_STEPS=""

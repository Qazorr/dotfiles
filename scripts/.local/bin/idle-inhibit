#!/usr/bin/env bash
# Prevent the screen from locking/dimming, on demand.
#
#   idle-inhibit on|off|toggle|status
#
# A real `systemd-inhibit --what=idle` lock, which hypridle checks for. NOT
# `dms ipc call inhibit toggle`, which is a no-op here — see the README.
set -euo pipefail

STATE="${XDG_RUNTIME_DIR:-/tmp}/idle-inhibit.pid"

notify() {
    # Falls back to notify-send, then nothing: never block on a missing one.
    if command -v dms >/dev/null 2>&1 && pgrep -x qs >/dev/null 2>&1; then
        dms ipc call toast "${2:-info}" "$1" >/dev/null 2>&1 && return 0
    fi
    command -v notify-send >/dev/null 2>&1 && notify-send "Idle inhibit" "$1" 2>/dev/null || true
}

active() {
    [ -f "$STATE" ] && kill -0 "$(cat "$STATE" 2>/dev/null)" 2>/dev/null
}

turn_on() {
    if active; then
        echo "already on"
        return 0
    fi
    # --mode=block, not delay: hold it until told otherwise.
    systemd-inhibit --what=idle --who="idle-inhibit" \
        --why="manually inhibited" --mode=block \
        sleep infinity &
    disown
    echo "$!" > "$STATE"
    notify "Enabled — screen won't lock or dim" "info"
    echo "on"
}

turn_off() {
    if ! active; then
        echo "already off"
        return 0
    fi
    kill "$(cat "$STATE")" 2>/dev/null || true
    rm -f "$STATE"
    notify "Disabled — normal idle timeouts apply" "info"
    echo "off"
}

case "${1:-toggle}" in
    on)     turn_on ;;
    off)    turn_off ;;
    toggle) active && turn_off || turn_on ;;
    status) active && echo "on" || echo "off" ;;
    *) echo "usage: idle-inhibit {on|off|toggle|status}" >&2; exit 1 ;;
esac

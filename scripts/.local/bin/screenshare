#!/usr/bin/env bash
set -euo pipefail

CONF="${SCREENSHARE_CONF:-$HOME/.config/hypr/screenshare.conf}"
RUN="${XDG_RUNTIME_DIR:-/tmp}"
STATE="$RUN/screenshare.state"        # "<count> <kind>", written by watch
SNAP="$RUN/screenshare.snapshot"      # option<TAB>original<TAB>applied
LOCK="$RUN/screenshare.lock"
SOCKET="${SCREENSHARE_SOCKET:-$RUN/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock}"

# A screenshot fires the same events as a share; a quiet second cancels the pair out.
SETTLE="${SCREENSHARE_SETTLE:-1}"

OPT_RE='^[a-zA-Z0-9_]+(:[a-zA-Z0-9_.]+)+$'
VAL_RE='^[A-Za-z0-9_.,()%#[:space:]-]+$'

die()  { echo "screenshare: $*" >&2; exit 1; }
warn() { echo "screenshare: $*" >&2; }

notify() {
    if command -v dms >/dev/null 2>&1 && pgrep -x qs >/dev/null 2>&1; then
        dms ipc call toast "${2:-info}" "$1" >/dev/null 2>&1 && return 0
    fi
    command -v notify-send >/dev/null 2>&1 && notify-send "Screen sharing" "$1" 2>/dev/null || true
}

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# Multi-word values and gradients come back under "custom", not "str".
get_option() {
    hyprctl -j getoption "$1" 2>/dev/null | jq -r '
        if   .int    != null then .int
        elif .float  != null then .float
        elif .str    != null then .str
        elif .custom != null then .custom
        else empty end' 2>/dev/null
}

# hyprctl exits 0 even on error, so success is the literal "ok" it prints.
hc() { [ "$(hyprctl "$@" 2>&1)" = ok ]; }

declare -a OPT_K=() OPT_V=() HOOK_START=() HOOK_STOP=()

# Re-read before every apply, and committed only on success, so a typo leaves
# the last good config in place instead of taking the watcher down.
load_conf() {
    [ -f "$CONF" ] || { warn "no $CONF, nothing to apply"; return 0; }
    local line key val n=0
    local -a k=() v=() hstart=() hstop=()
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
        [[ "$line" == *=* ]] || { warn "$CONF:$n: expected 'name = value', got: $line"; return 1; }
        key="$(trim "${line%%=*}")"
        val="$(trim "${line#*=}")"
        case "$key" in
            exec-start) [ -n "$val" ] && hstart+=("$val") ;;
            exec-stop)  [ -n "$val" ] && hstop+=("$val") ;;
            *)
                [[ "$key" =~ $OPT_RE ]] || { warn "$CONF:$n: bad option name: $key"; return 1; }
                [[ "$val" =~ $VAL_RE ]] || { warn "$CONF:$n: bad value for $key: $val"; return 1; }
                k+=("$key"); v+=("$val") ;;
        esac
    done < "$CONF"
    # Element-wise: a value like "5 5 5 5" has to stay one element.
    OPT_K=(); OPT_V=(); HOOK_START=(); HOOK_STOP=()
    [ ${#k[@]}      -gt 0 ] && OPT_K=("${k[@]}")
    [ ${#v[@]}      -gt 0 ] && OPT_V=("${v[@]}")
    [ ${#hstart[@]} -gt 0 ] && HOOK_START=("${hstart[@]}")
    [ ${#hstop[@]}  -gt 0 ] && HOOK_STOP=("${hstop[@]}")
    return 0
}

apply() {
    local i k v cur
    # Rebuilt each time, so re-applying after a reload snapshots what it restored.
    : > "$SNAP"
    for ((i = 0; i < ${#OPT_K[@]}; i++)); do
        k="${OPT_K[i]}"; v="${OPT_V[i]}"
        cur="$(get_option "$k")" || true
        [ -n "$cur" ] || { warn "unknown option, skipping: $k"; continue; }
        printf '%s\t%s\t%s\n' "$k" "$cur" "$v" >> "$SNAP"
        hc keyword "$k" "$v" || warn "could not set $k to $v"
    done
}

# From the snapshot, never defaults: a themer may have moved one meanwhile.
revert() {
    local k v
    if [ -s "$SNAP" ]; then
        while IFS=$'\t' read -r k v _; do
            [ -n "${k:-}" ] || continue
            hc keyword "$k" "$v" || warn "could not restore $k to $v"
        done < "$SNAP"
    fi
    rm -f "$SNAP"
}

hooks() {
    local cmd
    for cmd in "$@"; do
        [ -n "$cmd" ] || continue
        setsid sh -c "$cmd" >/dev/null 2>&1 &
    done
}

write_state() { printf '%s %s\n' "$1" "${2:-}" > "$STATE"; }

# Hyprland only announces transitions, so a watcher started mid-share would sit
# idle until the next one. The portal keeps a PipeWire node open for the cast.
portal_casts() {
    local n
    command -v pw-dump >/dev/null 2>&1 || { echo 0; return 0; }
    n="$(pw-dump 2>/dev/null | jq '[.[]
        | select(.type == "PipeWire:Interface:Node")
        | .info.props // {}
        | select((."media.class" // "") == "Video/Source")
        | select((."node.name"   // "") == "xdg-desktop-portal-hyprland")
        ] | length' 2>/dev/null)" || n=0
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    echo "$n"
}

# A free lock means no watcher, and then the state is genuinely unknown.
watching() { ! ( exec 8> "$LOCK"; flock -n 8 ); }

status() {
    local count=0 kind="" active=false
    if [ -r "$STATE" ]; then
        read -r count kind < "$STATE" || true
    fi
    [ "${count:-0}" -gt 0 ] 2>/dev/null && active=true
    if [ "${1:-}" = --json ]; then
        if ! watching; then
            echo '{"active":null,"kind":null,"count":0,"watching":false,"applied":[]}'
            return 0
        fi
        local applied="[]"
        if [ -s "$SNAP" ]; then
            applied="$(jq -R -s 'split("\n") | map(select(length > 0) | split("\t")
                                 | {option: .[0], from: .[1], to: .[2]})' < "$SNAP")" || applied="[]"
        fi
        jq -cn --argjson active "$active" \
               --arg     kind   "$kind" \
               --argjson count  "${count:-0}" \
               --argjson applied "$applied" \
            '{active: $active, kind: (if $kind == "" then null else $kind end),
              count: $count, watching: true, applied: $applied}'
        return 0
    fi
    watching || { echo unknown; return 0; }
    $active && echo on || echo off
}

test_run() {
    local secs="${1:-5}"
    [[ "$secs" =~ ^[0-9]+$ ]] || die "usage: screenshare test [seconds]"
    load_conf || die "$CONF has errors, nothing applied"
    echo "applying for ${secs}s…"
    apply
    hooks ${HOOK_START[@]+"${HOOK_START[@]}"}
    awk -F'\t' '{printf "  %s: %s -> %s\n", $1, $2, $3}' "$SNAP" 2>/dev/null || true
    sleep "$secs"
    revert
    hooks ${HOOK_STOP[@]+"${HOOK_STOP[@]}"}
    echo "reverted"
}

watch() {
    exec 9> "$LOCK"
    flock -n 9 || { echo "already watching" >&2; exit 0; }
    load_conf || die "$CONF has errors"
    [ -s "$SNAP" ] && { warn "restoring state from a previous session"; revert; }
    write_state 0 ""
    # Cleanup hangs off EXIT; a signal trap that only reverted left bash resuming
    # the read loop, which made the watcher survive its own SIGTERM.
    trap 'revert; write_state 0 ""' EXIT
    trap 'exit 0' INT TERM HUP

    local ev rc payload state owner count=0 kind="" applied=0
    count="$(portal_casts)"
    if [ "$count" -gt 0 ]; then
        kind=monitor
        write_state "$count" "$kind"
        warn "already sharing on startup ($count), applying"
    fi
    while :; do
        rc=0
        IFS= read -r -t "$SETTLE" ev || rc=$?
        if [ "$rc" -eq 0 ]; then
            case "$ev" in
                screencast\>\>*)
                    payload="${ev#screencast>>}"
                    state="${payload%%,*}"
                    owner="${payload#*,}"
                    # No aggregation: every client sends its own start and stop, so
                    # count. OWNER is the word "monitor"/"window", not a flag.
                    if [ "$state" = 1 ]; then
                        count=$((count + 1)); kind="$owner"
                    else
                        count=$((count - 1))
                        [ "$count" -lt 0 ] && count=0
                        [ "$count" -eq 0 ] && kind=""
                    fi
                    write_state "$count" "$kind" ;;
                configreloaded*)
                    # A reload drops every runtime keyword; apply re-snapshots.
                    [ "$applied" -eq 1 ] && apply ;;
            esac
            continue
        fi
        [ "$rc" -gt 128 ] || break     # not a timeout: socket closed, stop
        if [ "$count" -gt 0 ] && [ "$applied" -eq 0 ]; then
            load_conf || warn "keeping the last good config"
            apply; applied=1
            hooks ${HOOK_START[@]+"${HOOK_START[@]}"}
            if [ "$kind" = window ]; then
                notify "Sharing a window"
            else
                notify "Sharing your screen"
            fi
        elif [ "$count" -eq 0 ] && [ "$applied" -eq 1 ]; then
            revert; applied=0
            hooks ${HOOK_STOP[@]+"${HOOK_STOP[@]}"}
            notify "Sharing stopped, settings restored"
        fi
    # 9>&-: socat must not inherit the lock, or killing the watcher leaves it held.
    done < <(socat -U - "UNIX-CONNECT:$SOCKET" 9>&-)
}

[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || die "not inside a Hyprland session"

case "${1:-status}" in
    status) status "${2:-}" ;;
    watch)  watch ;;
    test)   test_run "${2:-5}" ;;
    *) echo "usage: screenshare {status [--json] | watch | test [seconds]}" >&2; exit 1 ;;
esac

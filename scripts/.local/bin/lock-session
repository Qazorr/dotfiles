#!/usr/bin/env bash
# Lock the session, defensively.
#
# hypridle's documented `pidof hyprlock || hyprlock` fails in practice: a
# hyprlock that starts without presenting a lock surface sticks around, pidof
# succeeds forever, and the session never locks again. So skip only if
# hyprlock is running AND actually locking.
set -euo pipefail

locking() {
    pgrep -x hyprlock >/dev/null 2>&1 || return 1
    # A real lock owns a session-lock surface. A hung hyprlock does not.
    hyprctl layers 2>/dev/null | grep -qi 'hyprlock' && return 0
    # Fall back to logind's view, in case the compositor names it differently.
    [ "$(loginctl show-session "${XDG_SESSION_ID:-}" -p LockedHint --value 2>/dev/null)" = "yes" ]
}

DRY=0
[ "${1:-}" = "--dry-run" ] && DRY=1

if locking; then
    [ "$DRY" = 1 ] && echo "would do nothing: hyprlock is already locking"
    exit 0
fi

if pgrep -x hyprlock >/dev/null 2>&1; then
    if [ "$DRY" = 1 ]; then
        echo "would clear a stale hyprlock (running but not locking), then lock"
        exit 0
    fi
    echo "lock-session: clearing a hyprlock that isn't presenting a lock surface" >&2
    pkill -x hyprlock || true
    sleep 0.3
fi

if [ "$DRY" = 1 ]; then
    echo "would start hyprlock (none running)"
    exit 0
fi

exec hyprlock

#!/usr/bin/env bash
set -euo pipefail

# Skips only when hyprlock is running AND actually locking. A hyprlock that
# starts without presenting a lock surface sticks around, and a plain pidof
# check would then leave the session unlockable for good.

locking() {
    pgrep -x hyprlock >/dev/null 2>&1 || return 1
    hyprctl layers 2>/dev/null | grep -qi 'hyprlock' && return 0
    [ "$(loginctl show-session "${XDG_SESSION_ID:-}" -p LockedHint --value 2>/dev/null)" = "yes" ]
}

DRY=0
[ "${1:-}" = "--dry-run" ] && DRY=1

if locking; then
    [ "$DRY" = 1 ] && echo "would do nothing: hyprlock is already locking"
    exit 0
fi

if pgrep -x hyprlock >/dev/null 2>&1; then
    if [ "$DRY" = 1 ]; then
        echo "would clear a stale hyprlock (running but not locking), then lock"
        exit 0
    fi
    echo "lock-session: clearing a hyprlock that isn't presenting a lock surface" >&2
    pkill -x hyprlock || true
    sleep 0.3
fi

if [ "$DRY" = 1 ]; then
    echo "would start hyprlock (none running)"
    exit 0
fi

exec hyprlock

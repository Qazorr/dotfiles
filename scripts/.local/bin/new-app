#!/usr/bin/env bash
# Scaffold a .desktop launcher entry — for a script, an AppImage, anything
# that doesn't ship one of its own. Verified live against DMS's launcher
# (Quickshell's DesktopEntries, which scans ~/.local/share/applications):
# a genuinely new file shows up within a second or two, no restart needed.
# Editing an existing entry in place is NOT guaranteed to refresh live —
# re-running this on the same name may need a moment or a DMS restart to
# show the change.
#
#   new-app <name> <exec> [icon]
#       --terminal            run in a terminal window
#       --comment "text"      subtitle shown in the launcher
#       --categories "Cat;"   defaults to "Utility;" — see the desktop-entry
#                             spec's registered category list
#
# <exec> is written to the Exec= line verbatim, including any arguments or
# %f/%u/%F/%U field codes — this does not rewrite or validate it beyond a
# soft "found on PATH?" check.
#
# <icon> can be a path to an image (resolved to absolute and used as-is —
# verified more reliable than a themed icon name, which silently falls back
# to a letter avatar if the active icon theme doesn't have it) or a bare
# icon-theme name if you already know one that resolves.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)"
# shellcheck source=../../../lib/common.sh
source "$REPO/lib/common.sh"

usage() {
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

[ $# -ge 1 ] || usage 1
[ "$1" = "-h" ] || [ "$1" = "--help" ] && usage 0

NAME="$1"; shift
EXEC="${1:-}"; [ -n "$EXEC" ] || die "need an exec command — new-app \"$NAME\" <exec> [icon]"
shift

ICON="" TERMINAL=false COMMENT="" CATEGORIES="Utility;"
[ $# -gt 0 ] && [[ "$1" != --* ]] && { ICON="$1"; shift; }

while [ $# -gt 0 ]; do
    case "$1" in
        --terminal)     TERMINAL=true; shift ;;
        --comment)      COMMENT="$2"; shift 2 ;;
        --categories)   CATEGORIES="$2"; shift 2 ;;
        *) die "unknown option: $1" ;;
    esac
done

# First word of Exec, so "code --ozone-platform=wayland %U" checks "code"
# rather than failing on its own flags.
first_word="${EXEC%% *}"
if [[ "$first_word" != /* ]] && ! command -v "$first_word" >/dev/null 2>&1; then
    warn "'$first_word' isn't on PATH right now — the entry will still be created, but won't launch until it is"
fi

if [ -n "$ICON" ]; then
    if [ -f "$ICON" ]; then
        ICON="$(readlink -f "$ICON")"
    elif [[ "$ICON" == /* ]]; then
        warn "icon path $ICON doesn't exist — using it anyway, but it won't render until it does"
    elif ! find /usr/share/icons ~/.local/share/icons -iname "${ICON}.*" 2>/dev/null | grep -q .; then
        warn "'$ICON' isn't a file and wasn't found in any installed icon theme — it may render as a plain letter avatar (verified: DMS falls back silently, not an error)"
    fi
fi

SLUG="$(echo "$NAME" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-\+/-/g; s/^-//; s/-$//')"
[ -n "$SLUG" ] || die "couldn't derive a filename from '$NAME'"

DIR="$HOME/.local/share/applications"
DEST="$DIR/$SLUG.desktop"
mkdir -p "$DIR"
[ -e "$DEST" ] && warn "overwriting existing $DEST — edits to an existing entry may not appear live; a fresh name always does"

{
    echo "[Desktop Entry]"
    echo "Type=Application"
    echo "Name=$NAME"
    [ -n "$COMMENT" ] && echo "Comment=$COMMENT"
    echo "Exec=$EXEC"
    [ -n "$ICON" ] && echo "Icon=$ICON"
    echo "Terminal=$TERMINAL"
    echo "Categories=$CATEGORIES"
} > "$DEST"

if command -v desktop-file-validate >/dev/null 2>&1; then
    desktop-file-validate "$DEST" || warn "desktop-file-validate flagged the file above — it may still work"
fi

log "Wrote $DEST"
echo "  Name:  $NAME"
echo "  Exec:  $EXEC"
[ -n "$ICON" ] && echo "  Icon:  $ICON"
echo "Should appear in the launcher (SUPER+D) within a second or two."

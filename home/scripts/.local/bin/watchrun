#!/usr/bin/env bash
set -euo pipefail

# watchrun [options] [-- command...]   rebuild and restart a command when files change
#
#   -w, --watch PATH      watch PATH, recursively (repeatable; default: .)
#   -e, --exts LIST       only react to these extensions, e.g. cpp,h,cmake
#   -i, --ignore NAME     don't watch directories called NAME (repeatable; always
#                         ignored: .git build node_modules .venv __pycache__)
#   -p, --prelude CMD     shell code run before the build and the command, e.g. a
#                         `source setup.bash` that defines the build function
#   -b, --build CMD       run CMD on every change; the command only starts if it passes
#   -s, --sudo            run the command with sudo (asks for the password once)
#   -d, --debounce SEC    wait for changes to settle this long (default 0.3)
#   -n, --no-clear        don't clear the screen before each run
#   -1, --once            build and run once, without watching
#
# Without options, settings come from a .watchrun file in the current directory,
# one "key value" per line (keys as above, long form, plus "run"):
#
#   watch    apps/WrenchLogger/src
#   watch    libs/NetworkTools
#   exts     cpp,h,hpp,cmake,yaml,txt
#   prelude  source setup.bash
#   build    build -t WrenchLogger
#   sudo
#   run      ./build/bin/WrenchLogger/WrenchLogger -c apps/WrenchLogger/cfg/ambarella.yaml
#
# Options on the command line are added to the file's. Needs inotifywait (inotify-tools).

usage() {
    sed -n '4,30p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

watch=() ignore=(.git build node_modules .venv __pycache__) exts="" prelude="" build=""
use_sudo=0 debounce=0.3 clear_screen=1 once=0 run=""

set_opt() { # key [value]
    case "$1" in
    watch) watch+=("$2") ;;
    exts) exts="$2" ;;
    ignore) ignore+=("$2") ;;
    prelude) prelude="$2" ;;
    build) build="$2" ;;
    sudo) use_sudo=1 ;;
    debounce) debounce="$2" ;;
    no-clear) clear_screen=0 ;;
    once) once=1 ;;
    run) run="$2" ;;
    *)
        echo "watchrun: unknown setting '$1'" >&2
        exit 2
        ;;
    esac
}

if [ -f .watchrun ]; then
    while read -r key value || [ -n "$key" ]; do
        case "$key" in "" | \#*) continue ;; esac
        set_opt "$key" "$value"
    done <.watchrun
fi

while [ $# -gt 0 ]; do
    case "$1" in
    -w | --watch) set_opt watch "${2:?watchrun: $1 needs a value}" && shift ;;
    -e | --exts) set_opt exts "${2:?watchrun: $1 needs a value}" && shift ;;
    -i | --ignore) set_opt ignore "${2:?watchrun: $1 needs a value}" && shift ;;
    -p | --prelude) set_opt prelude "${2:?watchrun: $1 needs a value}" && shift ;;
    -b | --build) set_opt build "${2:?watchrun: $1 needs a value}" && shift ;;
    -s | --sudo) set_opt sudo ;;
    -d | --debounce) set_opt debounce "${2:?watchrun: $1 needs a value}" && shift ;;
    -n | --no-clear) set_opt no-clear ;;
    -1 | --once) set_opt once ;;
    -h | --help) usage ;;
    --)
        shift
        [ $# -gt 0 ] && run="$(printf '%q ' "$@")"
        break
        ;;
    *)
        echo "watchrun: unknown option '$1' (the command goes after --)" >&2
        usage 2 >&2
        ;;
    esac
    shift
done

[ -n "$run" ] || [ -n "$build" ] || {
    echo "watchrun: nothing to run: give a command after -- or a build step" >&2
    usage 2 >&2
}
[ ${#watch[@]} -gt 0 ] || watch=(.)
command -v inotifywait >/dev/null || [ "$once" = 1 ] || {
    echo "watchrun: needs inotifywait: sudo apt install inotify-tools" >&2
    exit 1
}
[ "$use_sudo" = 0 ] || sudo -v

pid=""

say() { printf '\033[1;36m[watchrun]\033[0m %s\n' "$*" >&2; }

stop() {
    [ -n "$pid" ] || return 0
    if kill -0 "$pid" 2>/dev/null; then
        # sudo passes the signal on to its child; without sudo, signal the whole group.
        if [ "$use_sudo" = 1 ]; then kill -TERM "$pid" 2>/dev/null; else kill -TERM -- "-$pid" 2>/dev/null; fi
        for _ in $(seq 50); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done
        if kill -0 "$pid" 2>/dev/null; then
            say "still running after 5s, killing it"
            if [ "$use_sudo" = 1 ]; then sudo -n kill -KILL -- "-$pid" 2>/dev/null; else kill -KILL -- "-$pid" 2>/dev/null; fi
        fi
    fi
    wait "$pid" 2>/dev/null || true
    pid=""
}

start() {
    [ "$clear_screen" = 0 ] || clear
    if [ -n "$build" ]; then
        say "build: $build"
        if ! bash -c "${prelude:+$prelude; }$build"; then
            say "build failed, waiting for the next change"
            return 0
        fi
    fi
    [ -n "$run" ] || {
        say "build passed"
        return 0
    }
    local cmd="$run"
    [ "$use_sudo" = 0 ] || cmd="sudo $run"
    say "run: $cmd"
    # Own session, so a restart takes down everything the command started.
    setsid bash -c "${prelude:+$prelude; }exec $cmd" &
    pid=$!
}

trap 'stop; exit 130' INT TERM
trap stop EXIT

start
if [ "$once" = 1 ]; then
    [ -z "$pid" ] || wait "$pid"
    exit
fi

ext_re=""
[ -z "$exts" ] || ext_re="\.(${exts//,/|})$"
exclude="(^|/)($(printf '%s|' "${ignore[@]}" | sed 's/\./\\./g; s/|$//'))(/|$)"

say "watching ${watch[*]}${exts:+ for .${exts//,/, .}}"
while read -r path; do
    [ -z "$ext_re" ] || [[ "$path" =~ $ext_re ]] || continue
    # Let a burst of saves settle before restarting.
    while read -r -t "$debounce" _; do :; done
    say "changed: $path"
    stop
    start
done < <(inotifywait -m -r -q -e close_write,create,delete,move --format '%w%f' --exclude "$exclude" "${watch[@]}")

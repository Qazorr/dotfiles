# Separate from cava/.config/cava/config (the standalone TUI one, SUPER+ALT+C).
# This one is headless: no ncurses UI, just raw bar-height numbers streamed
# to stdout for the Quickshell bar widget to parse. Invoked as `cava -p
# ~/.config/cava/bar-config`.
[general]
bars = 10
framerate = 30

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 7
channels = mono

[smoothing]
noise_reduction = 55

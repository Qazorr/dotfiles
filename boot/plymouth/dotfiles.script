# The @-placeholders (host, OS, DMS colours) are filled in by boot/build.sh.

W = Window.GetWidth();
H = Window.GetHeight();
X = Window.GetX();
Y = Window.GetY();

MARGIN = 64;
LOG_LINES = 7;
LOG_STEP = 24;
MONO = "DejaVu Sans Mono 11";
SANS = "DejaVu Sans 11";
FPS = 50;

Window.SetBackgroundTopColor(@BG_RGB@);
Window.SetBackgroundBottomColor(@BG_RGB@);

bg.sprite = Sprite(Image("background.png").Scale(W, H));
bg.sprite.SetPosition(X, Y, -100);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.y = Y + H * 0.42 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(X + W / 2 - logo.image.GetWidth() / 2, logo.y, 10);

track.image = Image("track.png");
track.x = X + W / 2 - track.image.GetWidth() / 2;
track.y = logo.y + logo.image.GetHeight() + 40;
track.sprite = Sprite(track.image);
track.sprite.SetPosition(track.x, track.y, 10);

bar.image = Image("bar.png");
bar.sprite = Sprite();
bar.sprite.SetPosition(track.x, track.y, 11);
bar.width = 0;

fun progress_callback(duration, progress)
{
    w = Math.Int(track.image.GetWidth() * progress);
    if (w >= 1 && w != global.bar.width)
    {
        global.bar.width = w;
        global.bar.sprite.SetImage(bar.image.Scale(w, bar.image.GetHeight()));
    }
}
Plymouth.SetBootProgressFunction(progress_callback);

# ---- bottom right: which machine, and what it's doing ----

mode = Plymouth.GetMode();
if (mode == "shutdown")
    what = "shutting down";
else if (mode == "reboot")
    what = "restarting";
else
    what = "starting";

fun corner_right(text, line, r, g, b)
{
    img = Image.Text(text, r, g, b, 1, SANS);
    s = Sprite(img);
    s.SetPosition(X + W - MARGIN - img.GetWidth(), Y + H - MARGIN - (line + 1) * LOG_STEP, 10);
    return s;
}
info.host = corner_right("@HOST@", 1, @FG_RGB@);
info.os = corner_right("@OS@  ·  " + what, 0, @MUTED_RGB@);

# ---- bottom left: log, newest at the bottom ----

tick = 0;
fun refresh_callback()
{
    global.tick++;
}
Plymouth.SetRefreshFunction(refresh_callback);

fun pad2(n)
{
    if (n < 10)
        return "0" + n;
    return "" + n;
}

fun stamp()
{
    t = global.tick / FPS;
    s = Math.Int(t);
    return s + "." + pad2(Math.Int((t - s) * 100));
}

fun str_len(s)
{
    for (n = 0; n < 200; n++)
    {
        c = s.CharAt(n);
        if (!c || c == "")
            return n;
    }
    return n;
}

fun pretty(unit)
{
    n = str_len(unit);
    if (n > 8 && unit.SubString(n - 8, n) == ".service")
        return unit.SubString(0, n - 8);
    return unit;
}

log.count = 0;
for (i = 0; i < LOG_LINES; i++)
{
    log.time[i] = Sprite();
    log.name[i] = Sprite();
}

fun draw_line(slot, idx)
{
    age = LOG_LINES - 1 - slot;
    y = Y + H - MARGIN - (age + 1) * LOG_STEP;
    k = idx % LOG_LINES;
    if (age == 0)
    {
        t = Image.Text(global.log.stamp[k], @ACCENT_RGB@, 1, MONO);
        n = Image.Text(global.log.text[k], @FG_RGB@, 1, MONO);
    }
    else
    {
        t = Image.Text(global.log.stamp[k], @MUTED_RGB@, 1, MONO);
        n = Image.Text(global.log.text[k], @SUB_RGB@, 1, MONO);
    }
    global.log.time[slot].SetImage(t);
    global.log.time[slot].SetPosition(X + MARGIN + 72 - t.GetWidth(), y, 10);
    global.log.name[slot].SetImage(n);
    global.log.name[slot].SetPosition(X + MARGIN + 88, y, 10);
    global.log.time[slot].SetOpacity(1 - age * 0.13);
    global.log.name[slot].SetOpacity(1 - age * 0.13);
}

fun add_line(text)
{
    k = global.log.count % LOG_LINES;
    global.log.text[k] = text;
    global.log.stamp[k] = stamp();
    global.log.count++;
    for (slot = 0; slot < LOG_LINES; slot++)
    {
        idx = global.log.count - LOG_LINES + slot;
        if (idx >= 0)
            draw_line(slot, idx);
    }
}

# systemd only reports units as they start, so on the way down the one entry
# would be the splash's own unit; the log is for boot only.
fun status_callback(status)
{
    if (global.mode == "boot")
        add_line(pretty(status));
}
Plymouth.SetUpdateStatusFunction(status_callback);

fun message_callback(text)
{
    add_line(text);
}
Plymouth.SetMessageFunction(message_callback);

# ---- password / question prompts (encrypted disks) ----

prompt.label = Sprite();
prompt.entry = Sprite();

fun show_prompt(text, answer)
{
    a = Image.Text(text, @SUB_RGB@, 1, "DejaVu Sans 14");
    b = Image.Text(answer + "_", @FG_RGB@, 1, "DejaVu Sans Mono 16");
    global.prompt.label.SetImage(a);
    global.prompt.label.SetPosition(X + W / 2 - a.GetWidth() / 2, track.y + 48, 20);
    global.prompt.label.SetOpacity(1);
    global.prompt.entry.SetImage(b);
    global.prompt.entry.SetPosition(X + W / 2 - b.GetWidth() / 2, track.y + 80, 20);
    global.prompt.entry.SetOpacity(1);
}

fun password_callback(prompt, bullets)
{
    dots = "";
    for (i = 0; i < bullets; i++)
        dots += "•";
    show_prompt(prompt, dots);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun question_callback(prompt, entry)
{
    show_prompt(prompt, entry);
}
Plymouth.SetDisplayQuestionFunction(question_callback);

fun normal_callback()
{
    global.prompt.label.SetOpacity(0);
    global.prompt.entry.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal_callback);
